# Copy to .env.local and fill in. Next loads .env.local automatically; nothing here is sent to the browser.
# If this project sits beside siblings that share one key file, a .env one directory up is read as a fallback.

# Required. Without it every search falls back to a local scorer and answers `degraded: true`.
# From https://typesafe.ai
TYPE_SAFE_KEY=

# Optional fallbacks, tried in order if TypeSafe direct is unavailable.
# VERCEL_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional. "vercel" tries the AI gateway before classifier.dev batching. Default is "batch".
# JEV_PRIMARY=batch

# Optional. Characters of each company's description sent to Jev per finalist. Default 420.
# JEV_DETAIL=420
