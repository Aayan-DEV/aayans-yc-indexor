{
  "name": "icon-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build:native": "swiftc -O native/coreml_embed.swift -o native/coreml_embed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:motion": "swiftc -O native/motion.swift -o native/motion",
    "atlas": "node scripts/build-atlas.mjs",
    "cf:build": "node cloudflare/build-data.mjs && vite build --config cloudflare/vite.config.mjs",
    "cf:dev": "npm run cf:build && wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:deploy": "npm run cf:build && wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "border-beam": "^1.3.0",
    "geist": "^1.7.2",
    "matter-js": "^0.20.0",
    "metal-fx": "^2.0.10",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "thinking-orbs": "^0.3.1",
    "voice-glow": "^0.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  }
}
