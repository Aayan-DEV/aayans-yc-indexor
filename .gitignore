# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.example is the template and is committed; real keys never are.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Everything the app needs to run is committed: the logos, the vectors, the tags and the models.
# Clone it and it works. Only build output, dependencies and real keys stay out.

# Refilled by tools/yc-data/download.py and placeholders.py. Not committed because they would be 53 MB
# byte-identical to public/icons, which already holds all 6,241.
/tools/yc-data/logos/
/tools/yc-data/placeholders/
.wrangler/
cloudflare/dist/
cloudflare/.dry-run/
**/.dry-run/
