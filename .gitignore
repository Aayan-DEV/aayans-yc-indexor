# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.example is the template and is committed; real keys never are.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large local artefacts: the Core ML models, the compiled Swift helpers, and the vectors and tags
# that `npm run atlas` and the prep scripts produce
/models/
/native/coreml_embed
/data/library.json
native/motion
/data/letters.json
/data/meta_vectors_v3.f32
/data/jev_tags.json
